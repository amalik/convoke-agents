{
  "name": "convoke-agents",
  "version": "4.0.1",
  "description": "Agent teams for complex systems, compatible with BMad Method",
  "main": "index.js",
  "files": [
    "index.js",
    "scripts/",
    "_bmad/bme/_vortex/",
    "_bmad/bme/_enhance/",
    "_bmad/bme/_gyre/",
    "_bmad/bme/_artifacts/",
    "_bmad/bme/_portability/",
    "_bmad/bme/_team-factory/",
    "_bmad/_config/skill-manifest.csv",
    ".claude-plugin/",
    ".claude/skills/bmad-audit-skill-dirs/",
    "INSTALLATION.md",
    "UPDATE-GUIDE.md",
    "CHANGELOG.md",
    "CREDITS.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "src/"
  ],
  "//files": "scripts/migration/format-conversion does NOT ship, and the exclusion lives in a .npmignore inside that directory rather than as a '!' negation here — a negation would put a glob metacharacter into this array, which scripts/audit/lib/installed-tree.js parses to build the expected set of _bmad/bme/* modules; four hand-written attempts to make that parser tell a harmless negation from a coverage-shrinking one were all broken by adversarial review. It is i97 agent-conversion tooling: a contributor runs it from the repository, an operator has no use for it, and shipping it put 18 links into the package that an operator cannot follow. It is STILL MAINTAINED and must not be deleted: I97 Epic 2 is 2 of 7 done, so five agent conversions still run through it. Story dist-2.3a. JSON has no comments, hence this key; npm ignores it.",
  "bin": {
    "convoke-install-vortex": "scripts/install-vortex-agents.js",
    "convoke-install-gyre": "scripts/install-gyre-agents.js",
    "convoke-install": "scripts/install-all-agents.js",
    "convoke-update": "scripts/update/convoke-update.js",
    "convoke-version": "scripts/update/convoke-version.js",
    "convoke-migrate": "scripts/update/convoke-migrate.js",
    "convoke-doctor": "scripts/convoke-doctor.js",
    "convoke-register-skill": "scripts/convoke-register-skill.js",
    "convoke-validate-marketplace": "scripts/audit/validate-marketplace.js",
    "convoke-audit-skill-dirs": "scripts/audit/audit-skill-dirs.js",
    "convoke-audit-bmm-deps": "scripts/audit/audit-bmm-dependencies.js",
    "convoke-migrate-artifacts": "scripts/migrate-artifacts.js",
    "convoke-portfolio": "scripts/lib/portfolio/portfolio-engine.js",
    "convoke-export": "scripts/portability/convoke-export.js"
  },
  "scripts": {
    "install:agents": "node scripts/install-all-agents.js",
    "postinstall": "node scripts/postinstall.js",
    "test": "node scripts/test-runner.js tests/unit tests/team-factory tests/lib tests/audit",
    "test:p0": "node scripts/test-runner.js tests/p0",
    "test:p0:gate": "npm run test:p0",
    "test:integration": "node scripts/test-runner.js tests/integration",
    "test:all": "npm test && npm run test:integration && npm run test:p0",
    "test:coverage": "c8 node scripts/test-runner.js tests/unit tests/team-factory tests/lib tests/integration tests/p0 tests/audit",
    "lint": "eslint --max-warnings 0 scripts/ index.js tests/",
    "docs:audit": "node scripts/docs-audit.js",
    "audit:pacing": "node scripts/audit/vortex-pacing-check.js",
    "archive": "node scripts/archive.js",
    "generate:manifest": "node scripts/generate-manifest.js",
    "refs:audit": "node scripts/audit/reference-integrity.js --paths=\"_bmad-output,_bmad/bme,docs,$(ls *.md | paste -sd, -)\"",
    "check": "node scripts/convoke-check.js"
  },
  "keywords": [
    "convoke-agents",
    "bmad-enhanced",
    "bmad",
    "agents",
    "lean-startup",
    "validated-learning",
    "vortex",
    "contextualize",
    "externalize",
    "empathize",
    "systematize",
    "user-research",
    "decision-making",
    "mvp",
    "product-strategy",
    "ai-agents"
  ],
  "author": "Convoke Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amalik/convoke-agents.git"
  },
  "bugs": {
    "url": "https://github.com/amalik/convoke-agents/issues"
  },
  "homepage": "https://github.com/amalik/convoke-agents#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "fs-extra": "^11.3.3",
    "js-yaml": "^4.3.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@eslint/js": "^10.0.1",
    "c8": "^10.1.3",
    "eslint": "^10.0.0"
  }
}
